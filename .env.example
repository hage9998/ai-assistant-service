# App
APP_NAME=gamification-llm-service
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gamification_llm
DATABASE_ECHO=false

# JWT
JWT_SECRET=changeme-super-secret
JWT_ALGORITHM=HS256

# LLM / Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_TEMPERATURE=0.7

# Logging
LOG_LEVEL=INFO
