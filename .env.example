# App
APP_NAME=gamification-llm-service
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gamification_llm
DATABASE_ECHO=false

# JWT
JWT_SECRET=changeme-super-secret
JWT_ALGORITHM=HS256

# CORS (JSON array of allowed origins)
CORS_ORIGINS=["http://192.168.49.2:30007"]

# LLM / Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_TEMPERATURE=0.7

# MCP
MCP_SERVICE_URL=http://localhost:8100/mcp
MCP_TIMEOUT_SECONDS=10.0
MCP_TOOL_CALL_MAX_ITERATIONS=2

# Logging
LOG_LEVEL=INFO
